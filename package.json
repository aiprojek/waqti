{
  "name": "waqti",
  "private": true,
  "version": "0.0.0",
  "description": "Aplikasi waktu shalat untuk penggunaan pribadi dan tampilan jam digital masjid.",
  "author": "AI Projek",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron electron/main.cjs",
    "electron:build": "node scripts/build-electron.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.0",
    "dexie": "^3.2.4",
    "dompurify": "^3.1.6",
    "html5-qrcode": "^2.3.8",
    "peerjs": "^1.5.4",
    "qrcode": "^1.5.3",
    "quill": "^1.3.7",
    "recharts": "^2.12.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/node": "^22.14.0",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.aiprojek.waqti",
    "productName": "Waqti",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "buildResources": "assets"
    },
    "artifactName": "Waqti-${env.BUILD_VERSION}.${ext}",
    "extraMetadata": {
      "version": "${env.WIN_VERSION}"
    },
    "icon": "assets/icon.png",
    "win": {
      "icon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
